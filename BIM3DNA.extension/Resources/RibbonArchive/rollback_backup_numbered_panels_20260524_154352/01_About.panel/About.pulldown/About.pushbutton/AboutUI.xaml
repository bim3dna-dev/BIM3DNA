<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AboutWindow" Height="450" Width="600" WindowStyle="None" AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2CCED0" />
        <SolidColorBrush x:Key="AccentAltBrush" Color="#58D6A2" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#B9EEF0" />
        <Style x:Key="LogoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderElement" CornerRadius="8" Background="#16212B" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderElement" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="BorderElement" Property="BorderBrush" Value="{StaticResource AccentAltBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20" Background="#FFFFFF" BorderBrush="{StaticResource AccentBrush}" BorderThickness="4" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True">
                <Button x:Name="LogoButton" Style="{StaticResource LogoButtonStyle}" Width="196" Height="60" Margin="0,0,12,0" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="Open bim3dna.nl" DockPanel.Dock="Left">
                    <Grid Width="196" Height="60" Background="Transparent">
                        <Image x:Name="LogoImage" Width="180" Height="48" Margin="8,6,8,6" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <Button x:Name="CloseButton" Content="Close" Width="60" Height="25" Margin="0,10,10,0" HorizontalAlignment="Right" VerticalAlignment="Top" DockPanel.Dock="Right" />
            </DockPanel>

            <StackPanel Grid.Row="1" Margin="0,20,0,20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">
                <TextBlock Text="Welcome to BIM3DNA Toolbar!" FontSize="20" FontWeight="Bold" Foreground="#111827" TextAlignment="Center" Margin="0,0,0,10" />
                <TextBlock Text="BIM3DNA Toolbar supports Revit automation and AI-assisted workflows with focused tools for review, coordination, and model productivity." FontSize="14" Foreground="#334155" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20" />

                <Border Background="#F8FEFE" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="15">
                    <Border.Effect>
                        <DropShadowEffect Color="#2CCED0" Direction="0" ShadowDepth="0" Opacity="0.18" BlurRadius="18" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="RevitVersionText" Text="Revit Version: Unknown" Margin="0,5" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock x:Name="pyRevitVersionText" Text="pyRevit Version: Unknown" Margin="0,5" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock x:Name="ActiveIronPythonVersionText" Text="Active Python Engine Version: Unknown" Margin="0,5" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock x:Name="ActiveCPythonVersionText" Text="Detected CPython Version: Unknown" Margin="0,5" FontWeight="Bold" Foreground="#0F172A" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Center">
                <TextBlock Text="BIM3DNA" FontSize="12" Foreground="#64748B" />
                <TextBlock Text="Toolbar Version: 1.0" FontSize="12" Foreground="#64748B" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
